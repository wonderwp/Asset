{
  "name": "wonderwp/asset",
  "description": "WonderWp Asset Component",
  "type": "library",
  "keywords": [
    "asset",
    "WonderWp",
    "WordPress"
  ],
  "homepage": "https://github.com/wonderwp/Asset",
  "license": "MIT",
  "authors": [
    {
      "name": "Jeremy Desvaux",
      "homepage": "https://jdmweb.com"
    },
    {
      "name": "WonderWp Community",
      "homepage": "http://wonderwp.net/Contribution/Contributors.html"
    }
  ],
  "require": {
    "php": "^8.3",
    "wonderwp/logging": "dev-feature/php_8",
    "wonderwp/service": "dev-feature/php_8",
    "symfony/asset": "^7.4"
  },
  "autoload": {
    "psr-4": {
      "WonderWp\\Component\\Asset\\": "src",
      "WonderWp\\Component\\Asset\\Tests\\": "tests"
    },
    "exclude-from-classmap": [
      "/tests/"
    ]
  },
  "minimum-stability": "dev",
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "johnpbloch/wordpress": "^7.0",
    "wonderwp/functions": "dev-feature/php_8"
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist"
  },
  "config": {
    "allow-plugins": {
      "johnpbloch/wordpress-core-installer": true,
      "composer/installers": true
    }
  }
}
